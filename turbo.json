{
  "$schema": "https://turborepo.com/schema.json",
  "globalPassThroughEnv": [
    "TEST_DATABASE_URL",
    "DATABASE_URL",
    "DIRECT_DATABASE_URL",
    "CI",
    "PLAYWRIGHT_BROWSERS_PATH"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "generated/**"],
      "env": ["NEXT_PUBLIC_*", "SUPABASE_URL", "SUPABASE_ANON_KEY", "AUTH_MODE"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
