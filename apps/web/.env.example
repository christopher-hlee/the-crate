# Web app (Next.js on Vercel). Reads the catalog, writes user tables only.
DATABASE_URL=postgres://crate:crate@localhost:5433/crate
# Public Supabase values (also accepted as NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Local development without Supabase: AUTH_MODE=dev (refused on Vercel).
AUTH_MODE=dev
NEXT_PUBLIC_APP_URL=http://localhost:3000
NARROW_FILTER_THRESHOLD=5000
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTH=
STRIPE_PRICE_YEAR=
REVENUECAT_WEBHOOK_SECRET=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_FEATURE_ADS=0
