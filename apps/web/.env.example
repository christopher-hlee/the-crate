# Web app (Next.js on Vercel). Reads the catalog, writes user tables only.
DATABASE_URL=postgres://crate:crate@localhost:5433/crate
# Public Supabase values (also accepted as NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Local development without Supabase: AUTH_MODE=dev. A production server (next start) refuses
# dev auth unless ALLOW_DEV_AUTH=1 (end-to-end tests only), and always refuses it on Vercel.
AUTH_MODE=dev
# OAuth buttons on the login page (Supabase mode), e.g. google,apple. Enable each provider in
# Supabase too. Empty: email + password and magic-link sign-in only.
NEXT_PUBLIC_AUTH_PROVIDERS=
# Public origin: share links, robots.txt and sitemap URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Contact point on the Terms, Privacy and footer (App Store guideline 1.2). Unset shows a marked
# placeholder (support@example.com); set it before launch. Read at build time.
NEXT_PUBLIC_SUPPORT_EMAIL=
# Comments matching any of these are refused (comma separated; case-insensitive whole words or
# phrases, compared after NFKC). Keep the real list in the deployment's settings, not in git.
COMMENT_BLOCKED_TERMS=
NARROW_FILTER_THRESHOLD=5000
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTH=
STRIPE_PRICE_YEAR=
REVENUECAT_WEBHOOK_SECRET=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Ad space for plans with ads (Free); 1/true/on/yes turns it on. Never on or over the player.
NEXT_PUBLIC_FEATURE_ADS=0
# Archive (spec: cleared lane), off until the rights rules pass legal review. Files come from
# R2 (presigned URLs; same bucket as the worker) or, locally, from ASSET_STORE_DIR.
FEATURE_CLEARED_LANE=0
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
ASSET_STORE_DIR=
