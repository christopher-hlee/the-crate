# Worker: the only process that calls YouTube's Data API and writes catalog tables.
DIRECT_DATABASE_URL=postgres://crate:crate@localhost:5433/crate
YOUTUBE_API_KEY=
YT_DAILY_UNIT_BUDGET=8000
DISCOGS_DUMPS_BASE_URL=https://data.discogs.com/
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GETSONGBPM_API_KEY=
FEATURE_GETSONGBPM=0
SENTRY_DSN=
# Archive (spec: cleared lane): pd_rollover and recheck_rights run only with the flag on.
FEATURE_CLEARED_LANE=0
# Local archive files when R2 isn't configured.
ASSET_STORE_DIR=
# ffmpeg is found on PATH; set FFMPEG_PATH to override. Essentia's
# streaming_extractor_music adds tempo and key analysis when set.
FFMPEG_PATH=
ESSENTIA_EXTRACTOR=
