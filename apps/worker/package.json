{
  "name": "@app/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "cli": "node --max-old-space-size=8192 --import tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "build": "node build.mjs",
    "start": "node --enable-source-maps dist/cli.js start"
  },
  "dependencies": {
    "@app/core": "workspace:*",
    "@app/discogs": "workspace:*",
    "zod": "4.6.5",
    "@app/db": "workspace:*",
    "pg": "8.23.1",
    "@app/youtube": "workspace:*",
    "pg-boss": "12.36.0",
    "@aws-sdk/client-s3": "3.1146.0",
    "@aws-sdk/lib-storage": "3.1146.0",
    "@sentry/node": "11.4.0",
    "drizzle-orm": "0.45.3",
    "pg-copy-streams": "7.0.0",
    "saxes": "6.0.0",
    "@app/assets": "workspace:*"
  },
  "devDependencies": {
    "tsx": "4.23.15",
    "@types/pg": "8.23.1",
    "esbuild": "0.28.2"
  }
}
