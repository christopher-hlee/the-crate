# Mobile app (Expo). EXPO_PUBLIC_* values are inlined into the bundle: never put a secret here.
# For EAS builds, set them in the EAS environment instead.
EXPO_PUBLIC_API_URL=http://localhost:3000
# Local development without Supabase (needs AUTH_MODE=dev on the web app).
EXPO_PUBLIC_AUTH_MODE=dev
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# RevenueCat public SDK keys.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_SENTRY_DSN=
# Contact point on the Account screen (App Store guideline 1.2). Unset shows a marked
# placeholder (support@example.com); set it before submitting a build.
EXPO_PUBLIC_SUPPORT_EMAIL=
# Build-time options read by app.config.ts. The store app IDs feed the player's Referer; leave
# them commented out (not empty) to use the placeholder com.example.cratedig.
# APP_ID_IOS=com.example.cratedig
# APP_ID_ANDROID=com.example.cratedig
FEATURE_CLEARED_LANE=0
